# Put this file in your settings folder as .env, not in the repo:
#   macOS:   ~/Library/Application Support/AnyMeet/.env
#   Windows: %APPDATA%\AnyMeet\.env
#   Linux:   ~/.config/anymeet/.env
# The apps write it for you from Settings → Transcription.
GEMINI_API_KEY=
# TRANSCRIBER=gemini-3.5-transcribe
